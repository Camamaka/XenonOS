#!/bin/sh
# XenonOS (Debian 13 "trixie" + KDE Plasma) live-build yapilandirmasi.
# Kullanim: cd live-build && sudo lb config   (lb build ile ISO uretilir)
set -e

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures amd64 \
    --linux-flavours amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap http://deb.debian.org/debian/ \
    --mirror-chroot http://deb.debian.org/debian/ \
    --mirror-binary http://deb.debian.org/debian/ \
    --security true \
    --updates true \
    --binary-images iso-hybrid \
    --bootloaders "grub-efi,syslinux" \
    --debian-installer none \
    --iso-application "XenonOS" \
    --iso-publisher "XenonOS" \
    --iso-volume "XENONOS" \
    --image-name "xenonos" \
    --memtest none \
    --apt-indices false \
    --bootappend-live "boot=live components quiet splash locales=en_US.UTF-8 keyboard-layouts=tr timezone=Europe/Istanbul username=xenon hostname=xenonos" \
    "${@}"
